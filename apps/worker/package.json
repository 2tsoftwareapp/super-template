{
  "name": "@lean/worker",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --sourcemap --outfile=dist/main.js --external:pg-native",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "run:once": "tsx --env-file-if-exists=../../.env src/main.ts --once",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lean/db": "workspace:*",
    "nodemailer": "^7.0.0",
    "@lean/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "@types/nodemailer": "^7.0.0",
    "@types/smtp-server": "^3.5.10",
    "smtp-server": "^3.13.6",
    "vitest": "^4.1.9"
  }
}
