{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "node ../../scripts/run-with-port.mjs WEB_PORT 3000 pnpm exec next dev",
    "start": "node ../../scripts/run-with-port.mjs WEB_PORT 3000 pnpm exec next start",
    "format": "prettier --write .",
    "generate": "pnpm --filter api contract:generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test e2e/auth.spec.ts --workers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "5.4.0",
