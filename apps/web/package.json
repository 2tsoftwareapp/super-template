{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "node ../../scripts/run-with-port.mjs WEB_PORT 3000 pnpm exec next dev",
    "start": "node ../../scripts/run-with-port.mjs WEB_PORT 3000 pnpm exec next start",
    "format": "prettier --write .",
    "generate": "pnpm --filter api contract:generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repo/env-loader": "workspace:*",
    "@repo/web-server": "workspace:*",
    "@repo/web-test": "workspace:*",
    "@repo/web-ui": "workspace:*",
    "@repo/web-utils": "workspace:*",
    "@tanstack/react-query": "5.101.0",
    "dotenv": "17.4.2",
    "lucide-react": "0.552.0",
    "next": "16.2.9",
    "next-intl": "^4.13.2",
    "nuqs": "2.8.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "2.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.2.9",
    "@playwright/test": "1.61.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.9"
  }
}
