{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "biome format --write .",
    "generate": "pnpm run openapi:generate && pnpm run contract:generate",
    "lint": "biome check .",
    "openapi:generate": "ts-node --files --project tsconfig.json src/openapi/generate-openapi.ts",
    "contract:generate": "openapi-typescript ../../apps/api/openapi.json -o ../../packages/api-contract/src/generated/index.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:seed": "ts-node --files --project tsconfig.json src/database/seed.ts",
    "db:reset": "ts-node --files --project tsconfig.json src/database/reset.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "start": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/**/*.e2e-spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "helmet": "8.2.0",
    "nodemailer": "9.0.0",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@nestjs/cli": "11.0.12",
    "@nestjs/testing": "11.1.27",
    "@types/express": "5.0.4",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@repo/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "openapi-typescript": "7.13.0",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
