{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "biome format --write .",
    "generate": "pnpm run contract:generate",
    "lint": "eslint .",
    "openapi:generate": "ts-node --transpile-only -r tsconfig-paths/register --files --project tsconfig.json src/openapi/generate-openapi.ts",
    "contract:generate": "openapi-typescript ../../apps/api/openapi.json -o ../../packages/api-contract/src/generated/index.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/migrate.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:seed": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/reset.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "start": "node dist/main",
    "test": "vitest run test/unit ../../packages/api-core/src ../../packages/api-identity/src ../../packages/api-workspace/src",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/*.e2e.spec.ts --maxWorkers=1",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@repo/api-bootstrap": "workspace:*",
    "@repo/api-health": "workspace:*",
    "@repo/api-core": "workspace:*",
    "@repo/api-database": "workspace:*",
    "@repo/api-identity": "workspace:*",
    "@repo/api-platform": "workspace:*",
    "@repo/api-workspace": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "firebase-admin": "13.6.0",
    "helmet": "8.2.0",
    "nodemailer": "9.0.0",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@nestjs/cli": "11.0.12",
    "@nestjs/testing": "11.1.27",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "5.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "openapi-typescript": "7.13.0",
    "supertest": "7.1.4",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "webpack-node-externals": "3.0.0"
  }
}
