{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write .",
    "generate": "pnpm run contract:generate",
    "lint": "eslint .",
    "openapi:generate": "bash ../../scripts/generate-openapi.sh",
    "contract:generate": "openapi-typescript ../../apps/api/openapi.json -o ../../packages/api-contract/src/generated/index.ts",
    "db:migrate": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/migrate.ts",
    "db:seed": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register --files --project tsconfig.json src/cli/reset.ts",
    "start": "node dist/main",
    "test": "vitest run test/unit src/cli",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=1 test/unit src/cli",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts test/*.e2e.spec.ts --maxWorkers=1",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:features": "pnpm -r --filter \"./packages/feature-*\" test"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@repo/api-kernel": "workspace:*",
    "@repo/api-plugin-kit": "workspace:*",
    "@repo/app-composition": "workspace:*",
    "@repo/api-runtime": "workspace:*",
    "@repo/database-runtime": "workspace:*",
    "@repo/env-loader": "workspace:*",
    "@repo/feature-access-control": "workspace:*",
    "@repo/feature-activities": "workspace:*",
    "@repo/feature-audit": "workspace:*",
    "@repo/feature-audit-export": "workspace:*",
    "@repo/feature-auth": "workspace:*",
    "@repo/feature-health": "workspace:*",
    "@repo/feature-import-export": "workspace:*",
    "@repo/feature-jobs": "workspace:*",
    "@repo/feature-mail": "workspace:*",
    "@repo/feature-mfa": "workspace:*",
    "@repo/feature-notifications": "workspace:*",
    "@repo/feature-organizations": "workspace:*",
    "@repo/feature-organization-management": "workspace:*",
    "@repo/feature-outbox": "workspace:*",
    "@repo/feature-settings": "workspace:*",
    "@repo/feature-sso": "workspace:*",
    "@repo/feature-upload": "workspace:*",
    "@repo/feature-user-preferences": "workspace:*",
    "@repo/feature-users": "workspace:*",
    "@repo/feature-user-management": "workspace:*",
    "@repo/observability": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.12",
    "@nestjs/testing": "11.1.27",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "5.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "copy-webpack-plugin": "^12.0.2",
    "openapi-typescript": "7.13.0",
    "supertest": "7.1.4",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "webpack-node-externals": "3.0.0",
    "@repo/test-config": "workspace:*"
  }
}
