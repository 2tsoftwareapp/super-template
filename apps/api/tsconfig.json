{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@identity/*": [
        "../../packages/api-identity/src/*"
      ],
      "@platform/*": [
        "../../packages/api-platform/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "drizzle.config.ts"
  ]
}
