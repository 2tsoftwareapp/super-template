{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "src/*": ["./src/*"],
      "@repo/feature-identity": ["../../packages/features/identity/src/index.ts"],
      "@repo/feature-identity/*": ["../../packages/features/identity/src/*"],
      "@repo/feature-platform": ["../../packages/features/platform/src/index.ts"],
      "@repo/feature-platform/*": ["../../packages/features/platform/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
