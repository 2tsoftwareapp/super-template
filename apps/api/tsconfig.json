{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "dist",
    "strictPropertyInitialization": false,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "src/*": ["src/*"],
      "@repo/api-core": ["../../packages/api-core/src/index.ts"],
      "@repo/api-core/common/*": ["../../packages/api-core/src/common/*"],
      "@repo/api-core/config/*": ["../../packages/api-core/src/config/*"],
      "@repo/api-database": ["../../packages/api-database/src/index.ts"],
      "@repo/api-database/*": ["../../packages/api-database/src/*"],
      "@repo/api-identity": ["../../packages/api-identity/src/index.ts"],
      "@repo/api-identity/modules/*": ["../../packages/api-identity/src/modules/*"],
      "@repo/api-platform": ["../../packages/api-platform/src/index.ts"],
      "@repo/api-platform/modules/*": ["../../packages/api-platform/src/modules/*"],
      "@repo/api-workspace": ["../../packages/api-workspace/src/index.ts"],
      "@repo/api-workspace/modules/*": ["../../packages/api-workspace/src/modules/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "drizzle.config.ts",
    "../../packages/api-core/src/common/types/express.d.ts"
  ]
}
