{
  "name": "super-template-lean",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/web",
    "apps/worker",
    "packages/*",
    "docs"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter @lean/api dev",
    "dev:admin": "bun run --filter @lean/admin dev",
    "dev:web": "bun run --filter @lean/web dev",
    "dev:worker": "bun run --filter @lean/worker dev",
    "dev:all": "bun run --filter './apps/*' dev",
    "bootstrap": "docker compose up -d --wait && bun run db:migrate && bun run db:seed",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run --filter '@lean/db' --filter '@lean/api' --filter '@lean/worker' --filter '@lean/admin' --filter '@lean/web' build",
    "db:generate": "bun run --filter @lean/db generate",
    "db:migrate": "bun run --filter @lean/db migrate",
    "db:seed": "bun run --filter @lean/db seed",
    "docs:dev": "bun run --filter @lean/docs dev",
    "docs:build": "bun run --filter @lean/docs build",
    "prod:up": "docker compose -f compose.prod.yaml --env-file .env.production up -d --build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
