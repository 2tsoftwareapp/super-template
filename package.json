{
  "name": "super-template",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "env:doctor": "node scripts/env-doctor.mjs",
    "lint:web-architecture": "node scripts/check-web-architecture-boundaries.mjs",
    "lint:policy": "sh scripts/check-source-policy.sh && node scripts/check-web-architecture-boundaries.mjs && sh scripts/check-package-cycles.sh && node scripts/check-cross-feature-fks.mjs && node scripts/__tests__/check-cross-feature-fks.regression.mjs && node scripts/check-feature-manifest-deps.mjs && sh scripts/clean-policy-artifacts.sh && pnpm exec turbo boundaries",
    "build": "turbo run build",
    "dev": "./scripts/dev.sh",
    "dev:turbo": "turbo run dev",
    "lint": "pnpm run lint:policy && turbo run lint",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "mobile:doctor": "sh scripts/mobile.sh doctor",
    "mobile:setup": "sh scripts/mobile.sh setup",
    "mobile:dev": "sh scripts/mobile.sh dev",
    "mobile:test": "sh scripts/mobile.sh test",
    "mobile:analyze": "sh scripts/mobile.sh analyze",
    "mobile:format": "sh scripts/mobile.sh format",
    "mobile:format-check": "sh scripts/mobile.sh format-check",
    "mobile:check": "turbo run mobile:check",
    "mobile:build": "turbo run mobile:build",
    "format": "turbo run format",
    "test": "turbo run test",
    "test:coverage": "node scripts/run-coverage.mjs",
    "typecheck": "turbo run typecheck",
    "generate:contracts": "sh ./scripts/generate-contracts.sh",
    "generate:config": "pnpm --filter @repo/config generate",
    "generate": "sh ./scripts/generate-contracts.sh",
    "generate:check": "sh ./scripts/generate-check.sh",
    "schema:check": "node scripts/check-schema.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "create:project": "node scripts/create-project.mjs",
    "scaffold:feature": "node scripts/scaffold-feature.mjs",
    "generate:feature-indexes": "node scripts/generate-feature-indexes.mjs",
    "check:feature-indexes": "node scripts/generate-feature-indexes.mjs --check",
    "test:e2e:preflight": "node scripts/test-e2e-preflight.mjs",
    "verify": "sh ./scripts/verify.sh",
    "verify:offline": "node scripts/verify-offline.mjs",
    "extension:plan": "node .agents/skills/playwright-extension-live-browser/scripts/run-plan.mjs",
    "extension:session:reset": "node .agents/skills/playwright-extension-live-browser/scripts/reset-session.mjs",
    "browser-control:plan": "node .agents/skills/playwright-extension-live-browser/scripts/run-plan.mjs",
    "browser-control:session:reset": "node .agents/skills/playwright-extension-live-browser/scripts/reset-session.mjs",
    "format:check": "prettier --ignore-unknown --check \"packages/**\" \"apps/api\" \"apps/admin\" \"apps/web\"",
    "hooks:install": "node scripts/hooks/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@inquirer/prompts": "7.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.9.0",
    "globals": "17.6.0",
    "prettier": "3.6.2",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.9"
  },
  "workspaces": [
    "tools/tsc7",
    "apps/api",
    "apps/worker",
    "apps/admin",
    "apps/web",
    "apps/web/e2e",
    "tools/mobile-verification",
    "packages/*"
  ],
  "overrides": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/testing": "11.1.27",
    "@nestjs/throttler": "6.5.0"
  }
}
