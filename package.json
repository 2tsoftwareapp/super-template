{
  "name": "super-template",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "lint:policy": "node scripts/check-source-policy.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "pnpm run lint:policy && turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate": "turbo run generate",
    "verify": "pnpm run generate && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.9.0",
    "globals": "17.6.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.61.0",
    "turbo": "2.6.0"
  }
}
