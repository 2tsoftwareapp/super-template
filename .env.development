# ─────────────────────────────────────────────────────────────────────────────
# Development defaults (committed, non-secret).
#
# This file is loaded automatically when APP_ENV=development (the default) and
# layered on top of .env.example, so `make dev` works with zero setup. Anything
# not set here falls back to .env.example. Put personal overrides in
# .env.local or .env.development.local (both gitignored) — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
