DATABASE_URL=postgresql://lean:lean@localhost:5434/lean
API_PORT=3001
# Proxies allowed to set X-Forwarded-For (Express `trust proxy`); the admin BFF in production.
TRUST_PROXY=loopback
JWT_ACCESS_SECRET=dev-only-change-me-32-characters-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SMTP_URL=smtp://localhost:1025
# Used only by `pnpm db:seed` to create the first admin.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=ChangeMe123!
STORAGE_DIR=./storage
# Public URL of apps/web; password-reset mails link to ${WEB_URL}/reset-password.
WEB_URL=http://localhost:3000
# false turns off self-service sign-up (POST /auth/register).
ALLOW_REGISTRATION=true
MAX_UPLOAD_BYTES=5242880
MAIL_FROM=no-reply@example.local
