APP_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fullstack_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_starter
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fullstack_starter_test

API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
WORKSPACE_PORT=3103
INTERNAL_SERVICE_KEY=replace-with-a-long-internal-service-key
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_PATH=/api

JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.local
MAILPIT_HTTP_PORT=8025

POSTGRES_EXPOSED_PORT=5432
API_DOCS_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CSRF_SECRET=replace-with-a-third-long-random-development-secret

SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_EMAIL=user@example.local
SEED_USER_PASSWORD=ChangeMe123!

# Optional Firebase Cloud Messaging credentials for mobile push
# Demo project: examples/firebase-demo (project id: super-template-demo)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
