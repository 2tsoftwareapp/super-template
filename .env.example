# Runtime mode for local development, test, staging, or production.
APP_ENV=development

# Database connection used by the API and migration/bootstrap scripts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fullstack_starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Runtime API pool — must use the restricted application role (RLS enforced).
DATABASE_URL=postgresql://fullstack_starter_app:fullstack_starter_app@localhost:5432/fullstack_starter
# Privileged connection for db:migrate, db:reset, and Drizzle kit (postgres or owner).
DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_starter
DATABASE_URL_TEST=postgresql://fullstack_starter_app:fullstack_starter_app@localhost:5432/fullstack_starter_test
DATABASE_URL_TEST_ADMIN=postgresql://postgres:postgres@localhost:5432/fullstack_starter_test

# Core HTTP ports and app URLs.
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_PATH=/api
ADMIN_PORT=3002
ADMIN_ORIGIN=http://localhost:3002
# Optional Redis endpoint for shared throttling, cache, and fan-out. Leave empty to keep single-instance behavior.
REDIS_URL=redis://localhost:6379
# Access-profile cache TTL in seconds when Redis (or in-process fallback) is active.
ACCESS_PROFILE_CACHE_TTL_SECONDS=60

# Optional structured log export. Leave empty to keep logs console-only.
LOGGING_HTTP_ENDPOINT=
LOGGING_HTTP_AUTH_TOKEN=
LOGGING_HTTP_TIMEOUT_MS=2000

# Optional error reporting. Sentry captures exceptions; Telegram sends alerts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
TELEGRAM_ERROR_BOT_TOKEN=
TELEGRAM_ERROR_BOT_CHAT_ID=
TELEGRAM_ERROR_BOT_TIMEOUT_MS=2000

# JWT signing secrets and token lifetimes.
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Mail delivery and local Mailpit UI.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.local
MAILPIT_HTTP_PORT=8025

# Local Docker/test harness ports and demo toggles.
POSTGRES_EXPOSED_PORT=5432
API_DOCS_ENABLED=true
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
CSRF_SECRET=

# Bootstrap credentials used only for seed data and e2e setup.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_EMAIL=user@example.local
SEED_USER_PASSWORD=ChangeMe123!

# Optional Firebase Cloud Messaging credentials for mobile push.
# See apps/mobile/README.md for setup (google-services.json + service account key).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Object storage for uploads and generated files.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
