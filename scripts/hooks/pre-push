#!/usr/bin/env bash
# Pre-push gate: format + lint + typecheck must pass before any push.
# CI should never be the first tool to catch import-sort or formatting drift.
#
# Bypass (use sparingly — required CI checks still run server-side):
#   git push --no-verify
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

# Only run on pushes from the repo root checkout (refuse bare/no-worktree repos).
if [[ ! -f "package.json" ]]; then
  echo "pre-push: package.json not found; skipping checks." >&2
  exit 0
fi

# Prefer the pinned package manager; fall back to pnpm on PATH.
PM="pnpm"
if command -v corepack >/dev/null 2>&1; then
  PM="corepack pnpm"
fi

echo "▶ pre-push: format:check"
$PM run format:check

echo "▶ pre-push: lint (policy chain + turbo lint)"
$PM run lint

echo "▶ pre-push: typecheck"
$PM run typecheck

echo "✅ pre-push: format, lint, and typecheck passed."
