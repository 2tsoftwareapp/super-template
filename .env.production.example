# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment template.
#
# Copy to `.env.production` (gitignored) and fill in, or inject these via your
# secret store / orchestrator. Values marked [SECRET] must NEVER be committed.
# The API refuses to boot in production with placeholder secrets, insecure
# cookies, or non-https public URLs (see packages/api-runtime/src/config/environment/env.schema.ts).
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Database — managed Postgres, TLS required. Runtime pool uses the restricted
# application role (RLS enforced); migrations use a privileged role.
POSTGRES_HOST=your-prod-db-host
POSTGRES_PORT=5432
POSTGRES_DB=fullstack_starter
POSTGRES_USER=fullstack_starter_app
POSTGRES_PASSWORD=                      # [SECRET]
DATABASE_URL=                           # [SECRET] postgresql://app_role:***@host:5432/db?sslmode=require
DATABASE_MIGRATE_URL=                   # [SECRET] privileged connection for db:migrate
# Optional; required when the generated project selects --read-replica.
DATABASE_URL_READ_REPLICA=              # [SECRET] read-only managed replica URL with TLS

# HTTP endpoints and public URLs — must be https for browser-facing values.
API_PORT=3001
API_BODY_LIMIT=1mb
WEB_PORT=3000
WEB_ORIGIN=https://app.example.com
ADMIN_PORT=3002
ADMIN_ORIGIN=https://admin.example.com
API_INTERNAL_URL=http://api:3001        # server-to-server URL (may be internal http)
NEXT_PUBLIC_WEB_URL=https://app.example.com
NEXT_PUBLIC_API_BASE_PATH=/api

# Shared Redis for throttling/cache/fan-out (required when running >1 instance).
REDIS_URL=                              # [SECRET] e.g. rediss://prod-redis:6379
ACCESS_PROFILE_CACHE_TTL_SECONDS=60

# Error reporting.
SENTRY_DSN=                             # [SECRET]
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
TELEGRAM_ERROR_BOT_TOKEN=               # [SECRET]
TELEGRAM_ERROR_BOT_CHAT_ID=
TELEGRAM_ERROR_BOT_TIMEOUT_MS=2000

# Auth secrets — unique, high-entropy values. Placeholders are rejected at boot.
JWT_ACCESS_SECRET=                      # [SECRET]
JWT_REFRESH_SECRET=                     # [SECRET]
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# 32-byte hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=                     # [SECRET]
SSO_ENCRYPTION_KEY=                     # [SECRET] 32-byte hex key for SSO secrets at rest
AUDIT_RETENTION_DAYS=90

# SSO (leave a provider's client id empty to disable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                   # [SECRET]
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                      # [SECRET]
APPLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=                   # [SECRET]
GITHUB_REDIRECT_URI=
# Must be false in production (enforced at boot).
SSO_FAKE_PROVIDER_ENABLED=false

# Mail.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=no-reply@example.com

# Cookies/CSRF — production must use secure cookies (enforced at boot).
API_DOCS_ENABLED=false
COOKIE_SECURE=true
COOKIE_DOMAIN=.example.com
COOKIE_SAMESITE=lax
CSRF_SECRET=                            # [SECRET] required on web/admin BFFs (≥24 chars)

# Seed credentials — optional at API boot. Required only when running db:seed.
# db:seed / db:reset still refuse staging/production unless ALLOW_PROD_SEED=1 / ALLOW_PROD_RESET=1.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=                  # [SECRET]
# SEED_USER_EMAIL=
# SEED_USER_PASSWORD=                   # [SECRET]
# ALLOW_PROD_SEED=0
# ALLOW_PROD_RESET=0

# Never enable in production (boot refuses DATABASE_SKIP_RLS_CHECK=true when deployed).
# DATABASE_SKIP_RLS_CHECK=false

# Push notifications (optional).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=                        # [SECRET]

# Object storage — S3 (or compatible) in production.
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=                       # [SECRET]
S3_SECRET_ACCESS_KEY=                   # [SECRET]
S3_ENDPOINT=
