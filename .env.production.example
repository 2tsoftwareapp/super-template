# Production settings for compose.prod.yaml. Copy to .env.production (git-ignored)
# and replace every value; nothing here is safe to deploy as is.
POSTGRES_USER=lean
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=lean

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# The admin BFF reaches the API over the compose network (private addresses).
TRUST_PROXY=uniquelocal
# Browser origins that call the API directly (comma-separated); empty disables CORS.
CORS_ORIGINS=

SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=no-reply@example.com
MAX_UPLOAD_BYTES=5242880

# Public URLs, as users reach them through your reverse proxy.
ADMIN_ORIGIN=https://admin.example.com
ADMIN_URL=https://admin.example.com
WEB_ORIGIN=https://www.example.com
WEB_URL=https://www.example.com
# false turns off self-service sign-up on the web and mobile apps.
ALLOW_REGISTRATION=true

# First admin, created once by the seed step.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
