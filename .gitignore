# Env files: commit .env.example, .env.development, and .env.*.example only.
# Everything below is local/secret and must stay out of git.
.env
.env.local
.env.test
.env.staging
.env.production
.env.*.local
!.env.development
!.env.staging.example
!.env.production.example
# Local object-storage root (STORAGE_DRIVER=local). Anchored to the workspace root so the
# API and the worker share one directory; the apps/* paths are the legacy cwd-relative
# locations that only the API ever used.
/storage/
apps/api/storage/uploads/
apps/api/storage/exports/
apps/worker/storage/
*.tsbuildinfo

# verify-stack harness output: results.json, per-row logs, HTML report
.verify-stack/

# Next.js writes this next to tsconfig.json and rewrites its third line on every
# `next dev` / `next build` (see docs/development.md). It is generated output, so
# no committed copy can stay in sync — ignore it in every Next app.
next-env.d.ts

# Firebase — copy from *.example after creating your Firebase project
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist

# Browser-automation snapshots, screenshots, and logs (scratch output)
packages/extension/artifacts/

# Simple Skills — Work layer (sessions + memory; nested git)
.agent-work/
*.log

# Local tool junk
.freebuff/

# WorkBuddy AI — local workspace state (memory, sessions)
.workbuddy-ai/

# Git hooks installed by `pnpm hooks:install` (mirrors scripts/hooks)
.githooks/
