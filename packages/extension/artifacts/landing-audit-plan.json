{
  "cleanup": "created-tabs",
  "steps": [
    {
      "tool": "browser_resize",
      "args": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_console_messages",
      "args": {
        "level": "info",
        "all": true,
        "filename": "artifacts/landing-audit-console.log"
      }
    },
    {
      "tool": "browser_snapshot",
      "args": {
        "depth": 6,
        "filename": "artifacts/landing-audit-snapshot.yml"
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-desktop-full.png",
        "fullPage": true
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#architecture"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-architecture-desktop.png"
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#stack"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-stack-desktop.png"
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#get-started"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-get-started-desktop.png"
      }
    },
    {
      "tool": "browser_resize",
      "args": {
        "width": 390,
        "height": 844
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-mobile-top.png"
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#architecture"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-architecture-mobile.png"
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#get-started"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-get-started-mobile.png"
      }
    }
  ]
}
