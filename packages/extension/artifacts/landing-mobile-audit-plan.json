{
  "cleanup": "created-tabs",
  "steps": [
    {
      "tool": "browser_resize",
      "args": {
        "width": 1440,
        "height": 900
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#get-started"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-get-started-desktop.png"
      }
    },
    {
      "tool": "browser_resize",
      "args": {
        "width": 390,
        "height": 844
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 1
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "artifacts/landing-mobile-top.png"
      }
    },
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/#architecture"
      }
    },
    {
