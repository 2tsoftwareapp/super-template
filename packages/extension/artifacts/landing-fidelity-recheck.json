{
  "cleanup": "none",
  "steps": [
    {
      "tool": "browser_navigate",
      "args": {
        "url": "http://localhost:3005/"
      }
    },
    {
      "tool": "browser_wait_for",
      "args": {
        "time": 2
      }
    },
    {
      "tool": "browser_console_messages",
      "args": {
        "level": "info",
        "all": true,
        "filename": "landing-fidelity-console.log"
      }
    },
    {
      "tool": "browser_snapshot",
      "args": {
        "depth": 5,
        "filename": "landing-fidelity-snapshot.md"
      }
    },
    {
      "tool": "browser_take_screenshot",
      "args": {
        "type": "png",
        "filename": "landing-fidelity-full.png",
        "fullPage": true
      }
    }
  ]
}
