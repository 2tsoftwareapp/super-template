{
  "name": "@repo/feature-identity",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./web": "./src/web/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.web.config.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@repo/api-core": "workspace:*",
    "@repo/api-database": "workspace:*",
    "@repo/web-ui": "workspace:*",
    "@repo/web-utils": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "lucide-react": "0.552.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.27",
    "@repo/tsconfig": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
