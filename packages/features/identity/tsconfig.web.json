{
  "extends": "@repo/tsconfig/next.json",
  "compilerOptions": {
    "outDir": "dist-web",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": []
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/admin/**/*.ts"],
  "exclude": ["src/web/**/*.test.ts", "src/web/**/*.test.tsx", "src/web/**/*.spec.ts", "src/web/**/*.spec.tsx"]
}
