{
  "extends": "@repo/tsconfig/next.json",
  "compilerOptions": {
    "outDir": "dist-admin",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": []
  },
  "include": ["src/admin/**/*.ts", "src/admin/**/*.tsx"],
  "exclude": ["src/admin/**/*.test.ts", "src/admin/**/*.test.tsx"]
}
