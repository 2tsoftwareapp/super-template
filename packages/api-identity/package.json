{
  "name": "@repo/api-identity",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./modules/access-control": "./src/modules/access-control/index.ts",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./modules/*/*": "./src/modules/*/*.ts",
    "./modules/*/*/*": "./src/modules/*/*/*.ts",
    "./modules/auth": "./src/modules/auth/index.ts",
    "./modules/mfa": "./src/modules/mfa/index.ts",
    "./modules/organizations": "./src/modules/organizations/index.ts",
    "./modules/users": "./src/modules/users/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@repo/api-core": "workspace:*",
    "@repo/api-database": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/express": "5.0.4",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
