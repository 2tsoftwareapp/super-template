{
  "name": "@repo/feature-upload",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/public/contracts.ts",
    "./schema": "./src/infrastructure/persistence/index.ts",
    "./module": "./src/upload.module.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "RUN_S3_INTEGRATION=1 vitest run test/integration",
    "test:s3": "RUN_S3_INTEGRATION=1 vitest run test/integration/s3-object-storage.integration.spec.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@nestjs/common": "11.1.27",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/schedule": "6.1.1",
    "@nestjs/swagger": "11.4.4",
    "@repo/api-kernel": "workspace:*",
    "@repo/api-plugin-kit": "workspace:*",
    "@repo/api-runtime": "workspace:*",
    "@repo/database-runtime": "workspace:*",
    "@repo/feature-activities": "workspace:*",
    "@repo/feature-audit": "workspace:*",
    "@repo/feature-organizations": "workspace:*",
    "@repo/feature-users": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "@types/express": "5.0.4",
    "@repo/test-config": "workspace:*"
  }
}
