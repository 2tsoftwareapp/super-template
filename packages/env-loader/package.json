{
  "name": "@repo/env-loader",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../tools/tsc7/node_modules/typescript7/bin/tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "sideEffects": false
}
