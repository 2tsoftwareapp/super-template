{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["apps/api/openapi.json", "packages/api-contract/src/generated/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
