{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "boundaries": {
    "tags": {
      "layer:core": {
        "dependencies": {
          "allow": ["layer:core", "layer:env", "layer:sort", "layer:tsconfig", "layer:eslint"]
        }
      },
      "layer:env": {
        "dependencies": {
          "allow": ["layer:env", "layer:tsconfig", "layer:eslint"]
        }
      },
      "layer:database": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:env",
            "layer:database",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      },
      "layer:contract": {
        "dependencies": {
          "allow": ["layer:contract", "layer:sort", "layer:tsconfig", "layer:eslint"]
        }
      },
      "layer:health": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:env",
            "layer:database",
            "layer:health",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      },
      "layer:bootstrap": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:env",
            "layer:database",
            "layer:bootstrap",
            "layer:health",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      },
      "layer:app": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:env",
            "layer:database",
            "layer:bootstrap",
            "layer:health",
            "layer:contract",
            "layer:frontend-core",
            "layer:frontend-ui",
            "layer:frontend-test",
            "layer:app",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      },
      "layer:tsconfig": {
        "dependencies": {
          "allow": ["layer:tsconfig"]
        }
      },
      "layer:eslint": {
        "dependencies": {
          "allow": ["layer:eslint", "layer:tsconfig"]
        }
      },
      "layer:frontend-core": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:frontend-core",
            "layer:contract",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint",
            "layer:frontend-test"
          ]
        }
      },
      "layer:frontend-ui": {
        "dependencies": {
          "allow": [
            "layer:core",
            "layer:frontend-core",
            "layer:frontend-ui",
            "layer:frontend-test",
            "layer:contract",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      },
      "layer:frontend-test": {
        "dependencies": {
          "allow": [
            "layer:frontend-core",
            "layer:frontend-ui",
            "layer:frontend-test",
            "layer:contract",
            "layer:sort",
            "layer:tsconfig",
            "layer:eslint"
          ]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "APP_ENV",
        "NEXT_PUBLIC_APP_ENV",
        "API_INTERNAL_URL",
        "WEB_ORIGIN",
        "ADMIN_ORIGIN",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_PUBLIC_API_BASE_PATH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WEB_PORT", "ADMIN_PORT", "EXTENSION_MCP_PORT"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": [
        "$TURBO_ROOT$/apps/api/openapi.json",
        "$TURBO_ROOT$/packages/api-contract/src/generated/**"
      ]
    },
    "lint": {
      "dependsOn": []
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
