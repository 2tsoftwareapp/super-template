{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WEB_PORT", "ADMIN_PORT"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["$TURBO_ROOT$/apps/api/openapi.json", "$TURBO_ROOT$/packages/api-contract/src/generated/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
